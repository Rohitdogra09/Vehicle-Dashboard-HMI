        <property name="styleSheet">
         <string notr="true">QPushButton {
    background-color: #22c55e;
    color: white;
    border-radius: 15px;
    font-weight: bold;
    font-size: 14px;
    padding: 10px;
}

QPushButton:hover {
    background-color: #16a34a;
